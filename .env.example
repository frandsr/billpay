# ---------------------------------------------------------------------------
# Bill Pay — environment
# Copy to `.env` (git-ignored) and adjust if needed.
# Never commit real secrets: this file is tracked, `.env` is not.
# ---------------------------------------------------------------------------

# Local development (pnpm dev) against the dockerised Postgres from
# `docker compose up db`.
DATABASE_URL="postgresql://billpay:billpay@localhost:5432/billpay?schema=public"

# Postgres container credentials (read by docker-compose.yml).
POSTGRES_USER=billpay
POSTGRES_PASSWORD=billpay
POSTGRES_DB=billpay

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Invoice OCR — OPTIONAL.
#
# Get a key at https://aistudio.google.com/apikey. With it, uploaded invoices
# are read by `gemini-3.1-flash-lite`, falling back to `gemini-2.5-flash`.
#
# Leave it unset and everything still works: the upload falls back to a
# deterministic built-in extractor, so the build never depends on a secret being
# present (ADR 0010). Either way the result is a DRAFT for human review.
#
# docker-compose.yml already passes this through to the `app` service.
# GEMINI_API_KEY=

# Controls the start-up seed in docker/entrypoint.sh:
#   auto   (default) seed only when the database is empty
#   always reseed on every start — DESTROYS existing data
#   never  never seed
# `pnpm db:seed` always reseeds regardless of this value.
# SEED_ON_START=auto

# Port and bind address for the production server (Next.js standalone reads
# both). Defaults to 3000 / 0.0.0.0. Hosted platforms such as Railway inject
# their own PORT, which overrides these — do not hardcode it there.
# PORT=3000
# HOSTNAME=0.0.0.0
